# Base URL of the FastAPI backend (no trailing slash).
VITE_API_URL=http://localhost:8000

# true = use the in-memory mock API (src/services/mockApi.js) instead of the backend.
VITE_USE_MOCK=false

# Written to .env.local by `npm run seed:demo`. Local seeded database only; never commit.
# VITE_DEMO_ACCOUNTS=[{"id":1,"username":"mustapha","token":"..."}]
